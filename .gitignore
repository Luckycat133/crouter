logs/
.state/
config.sh
antigravity-claude-proxy/
.DS_Store

# Scratch directories that other AI coding tools drop into any repo they scan
# (.adal, .augment, .crush, .roo, .windsurf, ... — 50+ and growing). Ignore all
# dot-directories and re-include the ones this repo actually tracks.
.*/
!.github/
!.githooks/

# Local-only working files: skill checkouts and personal task/planning notes.
data/
skills/
skills-lock.json
TASKS-*.md
REFACTOR-PROMPT.md

# Local-only providers: personal/self-use providers never synced to GitHub
providers/darkbloom.sh
providers/*.local.sh

# Session-scoped provider plugins are release assets, including their hidden
# manifests and nested skill directories.
!assets/
!assets/**

# Reviewed project hook sources; other Codex state remains local.
!.codex/
.codex/*
!.codex/hooks.json
!.codex/hooks/
.codex/hooks/*
!.codex/hooks/session_start.py
!.codex/hooks/README.md
