#!/usr/bin/env node
'use strict';
// Provider-independent picker. Catalog I/O and normalization live in catalog.js.
const readline = require('node:readline');
const {loadCatalog, safeId, isFree, fmtPrice} = require('../lib/catalog.js');

function parseArgs(args) {
  const o = {provider: process.env.CR_PROVIDER || '', action: '', force: false};
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--provider') o.provider = args[++i] || '';
    else if (a.startsWith('--provider=')) o.provider = a.slice(11);
    else if (a === '--refresh') o.force = true;
    else if (a === '--set') { if (o.action) throw new Error('choose one action'); o.action = 'set'; o.model = args[++i]; }
    else if (['--list', '--list-free', '--current', '--help', '-h'].includes(a)) {
      if (o.action) throw new Error('choose one action');
      o.action = a.replace(/^--?/, '');
    } else throw new Error(`unknown argument: ${a}`);
  }
  if (['help', 'h'].includes(o.action)) return o;
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(o.provider)) throw new Error('a valid --provider is required');
  if (o.action === 'set' && !safeId(o.model)) throw new Error('--set requires a valid model ID');
  return o;
}
const {statePaths, current, saveSelection} = require('../lib/model-state.js');
function catalogUrls() {
  if (process.env.CR_MODELS_DISCOVERY === 'static' || process.env.CR_MODELS_DISCOVERY === 'native') return [];
  const urls = [];
  const add = (v) => { if (v && !urls.includes(v)) urls.push(v); };
  const explicit = process.env.CR_MODELS_API_URL;
  if (explicit) { add(explicit); return urls; }
  const base = process.env.CR_BASE_URL;
  if (base && /^https?:\/\//.test(base)) {
    const u = new URL(base);
    const p = u.pathname.replace(/\/+$/, '');
    u.pathname = p.endsWith('/v1') ? `${p}/models` : `${p}/v1/models`;
    add(u.toString());
  }
  return urls;
}
function clean(text) { return String(text).replace(/[\x00-\x1f\x7f-\x9f]/g, ''); }

async function picker(models, provider, selectedId, status) {
  return new Promise((resolve) => {
    const input = process.stdin, output = process.stdout;
    let query = '', freeOnly = false, cursor = Math.max(0, models.findIndex((m) => m.id === selectedId));
    let finished = false;
    const priorRaw = input.isRaw || false;
    const filtered = () => models.filter((m) => (!freeOnly || isFree(m)) && `${m.id} ${m.name}`.toLowerCase().includes(query.toLowerCase()));
    function render() {
      const list = filtered();
      cursor = Math.max(0, Math.min(cursor, list.length - 1));
      const height = Math.max(1, (output.rows || 24) - 7);
      const width = Math.max(20, output.columns || 80);
      const top = Math.max(0, cursor - height + 1);
      output.write('\x1b[2J\x1b[H');
      output.write(`${clean(provider)} Model Picker · ${list.length} · ${status}\nFilter: ${clean(query)}\n`);
      output.write('↑↓ 选择  Tab 免费筛选  Enter 确认  Esc 返回  Ctrl-C 取消\n');
      output.write('Model ID | Context | Price per 1M tokens\n');
      for (let i = top; i < Math.min(list.length, top + height); i++) {
        const m = list[i];
        const context = m.context_length ? String(m.context_length) : '?';
        const suffix = ` | ${context} | ${fmtPrice(m)}`;
        const nameWidth = Math.max(8, width - suffix.length - 4);
        const id = clean(m.id);
        output.write(`${i === cursor ? '> ' : '  '}${id.length > nameWidth ? id.slice(0, nameWidth - 1) + '…' : id}${suffix}\n`);
      }
      if (!list.length) output.write('没有匹配模型。\n');
    }
    function finish(result) {
      if (finished) return;
      finished = true;
      input.removeListener('keypress', onKey);
      input.removeListener('end', cancel);
      input.removeListener('error', cancel);
      for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.removeListener(sig, cancel);
      process.removeListener('SIGWINCH', render);
      if (input.isTTY) input.setRawMode(priorRaw);
      input.pause();
      output.write('\x1b[?25h\x1b[?1049l');
      resolve(result);
    }
    function cancel() { finish(null); }
    function onKey(text, key = {}) {
      if (key.name === 'escape' || (key.ctrl && ['c', 'd'].includes(key.name))) return cancel();
      const list = filtered();
      if (key.name === 'return' || key.name === 'enter') { if (list[cursor]) finish(list[cursor]); return; }
      if (key.name === 'up') cursor = Math.max(0, cursor - 1);
      else if (key.name === 'down') cursor = Math.min(list.length - 1, cursor + 1);
      else if (key.name === 'pageup') cursor = Math.max(0, cursor - 10);
      else if (key.name === 'pagedown') cursor = Math.min(list.length - 1, cursor + 10);
      else if (key.name === 'tab') { freeOnly = !freeOnly; cursor = 0; }
      else if (key.name === 'backspace') { query = [...query].slice(0, -1).join(''); cursor = 0; }
      else if (!key.ctrl && !key.meta && text && !/[\x00-\x1f\x7f]/.test(text)) { query += text; cursor = 0; }
      render();
    }
    readline.emitKeypressEvents(input);
    input.on('keypress', onKey);
    input.once('end', cancel);
    input.once('error', cancel);
    for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.once(sig, cancel);
    process.on('SIGWINCH', render);
    output.write('\x1b[?1049h\x1b[?25l');
    if (input.isTTY) input.setRawMode(true);
    input.resume();
    render();
    if (input.readableEnded || input.destroyed) cancel();
  });
}
async function main() {
  const args = parseArgs(process.argv.slice(2));
  if (['help', 'h'].includes(args.action)) {
    console.log('usage: crouter-models --provider <name> [--list|--list-free|--current|--set <id>] [--refresh]\nEsc/Ctrl-C/EOF: cancel (exit 2); q is a search character.');
    return;
  }
  const paths = statePaths(args.provider);
  if (args.action === 'current') { console.log(current(paths) || '(none)'); return; }
  if (!args.action && !args.force && !process.stdout.isTTY) throw new Error('stdout is not a TTY; use --list or --set');
  const urls = catalogUrls();
  const controller = new AbortController();
  const abort = () => controller.abort();
  process.once('SIGINT', abort); process.once('SIGTERM', abort);
  let result;
  try {
    result = await loadCatalog({provider: args.provider, urls, staticModels: (process.env.CR_STATIC_MODELS || '').split(/\s+/).filter(Boolean), cacheFile: paths.cache,
      auth: process.env.CR_MODELS_API_AUTH || 'none', token: process.env.CR_API_KEY || '',
      authOrigin: process.env.CR_MODELS_AUTH_ORIGIN || (urls[0] ? new URL(urls[0]).origin : ''),
      surface: process.env.CR_MODELS_API_SURFACE || 'legacy', force: args.force, signal: controller.signal});
  } catch (e) {
    if (controller.signal.aborted) { console.log('Cancelled.'); process.exitCode = 2; return; }
    throw e;
  } finally { process.removeListener('SIGINT', abort); process.removeListener('SIGTERM', abort); }
  if (controller.signal.aborted) { console.log('Cancelled.'); process.exitCode = 2; return; }
  if (args.action === 'list' || args.action === 'list-free') {
    console.log(JSON.stringify(args.action === 'list-free' ? result.models.filter(isFree) : result.models, null, 2)); return;
  }
  if (args.force && !args.action) {
    console.log(`${args.provider}: ${result.source}${result.stale ? ' (stale)' : ''}; ${result.models.length} models`); return;
  }
  let model;
  if (args.action === 'set') {
    model = result.models.find((m) => m.id === args.model);
    if (!model) throw new Error('model is not in this catalog; refresh or configure an explicit model');
  } else model = await picker(result.models, args.provider, current(paths), `${result.source}${result.stale ? ' · 过期缓存' : ''}`);
  if (!model) { console.log('Cancelled.'); process.exitCode = 2; return; }
  saveSelection(paths, args.provider, model);
  console.log(`✓ ${args.provider}: model set to ${model.id}`);
}
module.exports = {picker, parseArgs, catalogUrls};
if (require.main === module) main().catch((e) => { console.error(`crouter-models: ${e.message}`); process.exitCode = 1; });
