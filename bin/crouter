#!/bin/sh
# crouter - Claude Code model and credential routing.
#
# Usage:
#   crouter                               Interactive home (TTY); selected target (pipes)
#   crouter run [args...]                 Launch the selected target without a menu
#   crouter use [<provider>|app/<name>]    Show or select a persistent target
#   crouter use --clear                   Clear the persistent target
#   crouter claude [args...]              Native Claude Code login/passthrough
#   crouter <provider> [<model>] [args...] Launch with the provider
#   crouter <provider> --browse           Choose a model, then launch
#   crouter <provider> --apply-only       Save selection without starting services
#   crouter models <provider> [--list|--refresh|--set <id>]
#                                         Read/select models without launching Claude
#   crouter all [--check]                 Unified gateway / redacted route proof
#   crouter list [--all]                  Configured providers / full catalog
#   crouter list keys <provider>          Registered keys (never secret values)
#   crouter doctor [provider]             Diagnostics without starting services
#   crouter add [provider]                Interactive key setup
#   crouter remove <provider> --name <service> [--surface plan|api]
#   crouter provider show <provider>     Provider configuration
#   crouter migrate export|import|verify <file>
#   crouter config show|path              Configuration metadata
#   crouter logs list|tail <provider>     Logs
#   crouter uninstall [-y]                Remove this checkout's installed command
#   crouter app <name> [args...]          Frozen legacy native-CLI compatibility
#   crouter --version                     Version
#   crouter <command> --help              Command usage
#
set -u
SELF=$0
while [ -h "$SELF" ]; do
  self_dir=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$self_dir/$link ;; esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
PROVIDERS_DIR=$ROOT_DIR/providers
LIB_DIR=$ROOT_DIR/lib

# A deliberately installed optional claude wrapper routes only a real provider
# name. Every other argument belongs to the actual Claude CLI, not crouter.
if [ "${0##*/}" = claude ]; then
  case ${1:-} in
    ''|-*) set -- claude "$@" ;;
    *) [ -f "$PROVIDERS_DIR/$1.sh" ] || set -- claude "$@" ;;
  esac
fi
# Migration must inspect bytes without evaluating imported configuration.
if [ "${1:-}" = migrate ]; then
  shift
  _migration_node=${NODE_BIN:-$(command -v node 2>/dev/null || true)}
  [ -n "$_migration_node" ] || { printf 'crouter: migration requires Node.js\n' >&2; exit 1; }
  exec "$_migration_node" "$LIB_DIR/device-migration.js" "$ROOT_DIR" "$@"
fi
if [ "${1:-}" = app ]; then
  . "$LIB_DIR/native-apps.sh"
  shift
  native_app_dispatch "$@"
  exit $?
fi
# Bare crouter is interactive only when BOTH streams are terminals. Never eat
# stdin belonging to a piped Claude prompt, and never change crouter run.
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then set -- home; fi
case ${1:-} in
  use|run|'')
    . "$LIB_DIR/native-apps.sh"
    . "$LIB_DIR/selection.sh"
    if [ "${1:-}" = use ]; then shift; selection_dispatch "$@"; exit $?; fi
    [ "${1:-}" = run ] && shift
    selection_require || exit $?
    if [ "$CROUTER_SELECTION_KIND" = app ]; then native_app_run "$CROUTER_SELECTION_NAME" "$@"; exit $?; fi
    set -- "$CROUTER_SELECTION_NAME" "$@"
    ;;
esac
VERSION=$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf unknown)
CLAUDE_BIN=${CLAUDE_BIN:-}
LOG_DIR=${LOG_DIR:-$ROOT_DIR/logs}
STATE_DIR=${STATE_DIR:-$ROOT_DIR/.state}
[ ! -f "$ROOT_DIR/.state/migration-env.sh" ] || . "$ROOT_DIR/.state/migration-env.sh"
[ ! -f "$ROOT_DIR/config.sh" ] || . "$ROOT_DIR/config.sh"
if [ -z "$CLAUDE_BIN" ]; then CLAUDE_BIN=$(command -v claude 2>/dev/null || true); fi
NODE_BIN=${NODE_BIN:-$(command -v node 2>/dev/null || true)}
die() { printf 'crouter: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
usage() { sed -n '/^# Usage:/,/^#$/p' "$SELF" | sed 's/^# \{0,1\}//'; }
usage_list() { info 'usage: crouter list [--all]'; info '       crouter list keys <provider>'; info '       crouter list <provider>'; }
usage_list_keys() { info 'usage: crouter list keys <provider>'; info '       crouter list <provider>'; }
usage_doctor() { info 'usage: crouter doctor [<provider>]'; }
usage_add() {
  info 'usage: crouter add [<provider> [--surface plan|api] [--name <service>] [--stdin]]'
  info '       crouter add [--all] [--stdin]'
}
usage_remove() { info 'usage: crouter remove <provider> --name <service> [--surface plan|api] [-y]'; }
usage_provider() { info 'usage: crouter provider show <provider>'; info '       crouter provider <provider>'; }
usage_config() { info 'usage: crouter config show'; info '       crouter config path'; }
usage_logs() { info 'usage: crouter logs list'; info '       crouter logs tail <provider>'; }
for _mod in provider auth key-mgmt assets launch catalog; do . "$LIB_DIR/$_mod.sh"; done

# Resolving our optional wrapper as CLAUDE_BIN must fail before any hook runs.
# Physical-file equality catches a symlink as well as the direct checkout path.
check_claude_binary() {
  [ -n "$CLAUDE_BIN" ] && [ -x "$CLAUDE_BIN" ] || die 'claude binary not found; set CLAUDE_BIN in config.sh'
  _ccb_path=$CLAUDE_BIN _ccb_count=0
  while [ -L "$_ccb_path" ]; do
    _ccb_count=$((_ccb_count + 1)); [ "$_ccb_count" -lt 40 ] || die 'Claude executable symlink loop'
    _ccb_link=$(readlink "$_ccb_path")
    case $_ccb_link in /*) _ccb_path=$_ccb_link ;; *) _ccb_path=$(dirname "$_ccb_path")/$_ccb_link ;; esac
  done
  _ccb_real=$(CDPATH= cd -- "$(dirname -- "$_ccb_path")" && pwd)/${_ccb_path##*/}
  [ "$_ccb_real" != "$BIN_DIR/crouter" ] || die 'CLAUDE_BIN resolves to crouter itself; set it to the real Claude executable'
}
run_pre_start() { [ -n "$PRE_START" ] || return 0; eval "$PRE_START" || die "PRE_START hook failed for '$PROVIDER_NAME'"; }
cmd_claude() { check_claude_binary; exec "$CLAUDE_BIN" "$@"; }

cmd_run() {
  _p=$1; shift
  load_provider "$_p"
  _default_model=$MODEL _default_context=$CONTEXT_TOKENS _default_compact=$AUTO_COMPACT_TOKENS
  _main_model= _model_set=0 _pos_model= _pos_idx=0 _seen_flag=0
  _n=$# _i=0 _expect_model=0 _browse=0 _apply_only=0 _refresh=0 _bypass_auth=0 _passthrough=0
  for _a in "$@"; do
    _i=$((_i + 1))
    [ "$_passthrough" -eq 0 ] || continue
    if [ "$_expect_model" -eq 1 ]; then
      case $_a in ''|-*) die '--model requires a non-empty model value' ;; esac
      _main_model=$_a _model_set=1 _seen_flag=1 _expect_model=0
      continue
    fi
    case $_a in
      --) _passthrough=1; _seen_flag=1 ;;
      --model=*) _main_model=${_a#--model=}; [ -n "$_main_model" ] || die '--model requires a non-empty model value'; _model_set=1; _seen_flag=1 ;;
      --model) _expect_model=1; _seen_flag=1 ;;
      --browse) _browse=1; _seen_flag=1 ;;
      --apply-only) _apply_only=1; _seen_flag=1 ;;
      --refresh) _refresh=1; _seen_flag=1 ;;
      --version|-V|--help|-h) _bypass_auth=1; _seen_flag=1 ;;
      -*) _seen_flag=1 ;;
      *) if [ "$_seen_flag" -eq 0 ] && [ -z "$_pos_model" ]; then _pos_model=$_a; _pos_idx=$_i; fi ;;
    esac
  done
  [ "$_expect_model" -eq 0 ] || die '--model requires a non-empty model value'
  if [ "$_browse" -eq 1 ] && { [ "$_model_set" -eq 1 ] || [ -n "$_pos_model" ]; }; then die 'choose either a model or --browse, not both'; fi
  # Remove only router-owned flags and the positional model. Claude arguments
  # (including their values) keep their order and byte boundaries.
  _i=0 _skip_model_value=0 _passthrough=0
  while [ "$_i" -lt "$_n" ]; do
    _i=$((_i + 1)); _first=$1; shift
    if [ "$_passthrough" -eq 1 ]; then set -- "$@" "$_first"; continue; fi
    if [ "$_skip_model_value" -eq 1 ]; then _skip_model_value=0; continue; fi
    if [ "$_i" -eq "$_pos_idx" ]; then continue; fi
    case $_first in
      --) _passthrough=1 ;;
      --model) _skip_model_value=1 ;;
      --model=*|--browse|--apply-only|--refresh) ;;
      *) set -- "$@" "$_first" ;;
    esac
  done
  if [ "$_model_set" -eq 1 ]; then :
  elif [ -n "$_pos_model" ]; then _main_model=$_pos_model
  else
    _main_model=$MODEL
    _remembered=$(load_last_selected_model "$PROVIDER_NAME")
    [ -z "$_remembered" ] || _main_model=$_remembered
  fi
  if [ "$_browse" -eq 1 ] && [ "$_bypass_auth" -eq 0 ]; then
    # Directory access may resolve a directory credential, but it never starts
    # PRE_START, inference proxies, MCP servers or Claude.
    if [ "$_refresh" -eq 1 ]; then catalog_run --refresh --list >/dev/null || return $?; fi
    catalog_run
    _pick_rc=$?
    if [ "$_pick_rc" -eq 2 ]; then info "$PROVIDER_NAME: model selection cancelled; nothing was started"; return 0; fi
    [ "$_pick_rc" -eq 0 ] || return "$_pick_rc"
    _main_model=$(load_last_selected_model "$PROVIDER_NAME")
    [ -n "$_main_model" ] || die 'no model selected'
  fi
  _main_model=$(resolve_model_id "$_main_model") || return 1
  # A non-default model never inherits an unrelated default/previous context.
  if [ "$_main_model" = "$_default_model" ]; then
    CONTEXT_TOKENS=$_default_context AUTO_COMPACT_TOKENS=$_default_compact
  else
    CONTEXT_TOKENS= AUTO_COMPACT_TOKENS=
  fi
  _bound_context=$(model_state_context "$PROVIDER_NAME" "$_main_model")
  if [ -n "$_bound_context" ]; then
    if [ -z "$CONTEXT_TOKENS" ] || [ "$_bound_context" -lt "$CONTEXT_TOKENS" ]; then CONTEXT_TOKENS=$_bound_context; fi
  fi
  apply_model_context_override "$_main_model"
  apply_model_tier_settings "$_main_model"
  apply_model_self_route "$_main_model"
  if [ -n "$CONTEXT_TOKENS" ]; then
    case $CONTEXT_TOKENS in *[!0-9]*|?????????*|'') die 'invalid model context' ;; esac
    case $AUTO_COMPACT_TOKENS in *[!0-9]*|?????????*) die 'invalid compaction window' ;; esac
    if [ -n "$AUTO_COMPACT_TOKENS" ] && [ "$AUTO_COMPACT_TOKENS" -gt "$CONTEXT_TOKENS" ]; then AUTO_COMPACT_TOKENS=; fi
  fi
  if [ "$_apply_only" -eq 1 ] && [ "$_bypass_auth" -eq 0 ]; then
    [ -n "$NODE_BIN" ] || die 'saving a model selection requires Node.js'
    "$NODE_BIN" "$LIB_DIR/model-state.js" write "$PROVIDER_NAME" "$_main_model" "$CONTEXT_TOKENS" || return $?
    info "$PROVIDER_NAME: applied $_main_model (context=${CONTEXT_TOKENS:-unknown}, effort=${EFFORT:-unset}); no services started"
    return 0
  fi
  check_claude_binary
  AUTH_TOKEN=
  if [ "$_bypass_auth" -eq 0 ]; then
    _crouter_prelaunch_cleanup_done=0
    _crouter_prelaunch_cleanup() {
      [ "${_crouter_prelaunch_cleanup_done:-0}" -eq 0 ] || return 0
      _crouter_prelaunch_cleanup_done=1
      [ -n "${POST_STOP:-}" ] && eval "$POST_STOP" || true
      if [ -n "${KEYPOOL_PID:-}" ]; then kill "$KEYPOOL_PID" 2>/dev/null || true; wait "$KEYPOOL_PID" 2>/dev/null || true; fi
      cleanup_provider_assets || true
      return 0
    }
    trap '_crouter_prelaunch_cleanup' EXIT
    trap '_crouter_prelaunch_cleanup; exit 130' INT
    trap '_crouter_prelaunch_cleanup; exit 143' TERM
    run_pre_start
    if is_dual_source; then resolve_dual_source; start_dual_failover
    elif [ "${AUTH_MODE:-}" = surfaces ]; then start_surface_pool
    elif [ "${AUTH_MODE:-}" = keypool ]; then
      _main_count=$(set -- $AUTH_KEYS; echo $#)
      _plus_count=$(set -- ${PLUS_KEYS:-}; echo $#)
      if [ "$_main_count" -eq 1 ] && [ "$_plus_count" -eq 0 ]; then
        AUTH_REFERENCE=$(set -- $AUTH_KEYS; printf '%s' "$1"); AUTH_MODE=keychain; resolve_auth
      else start_keypool; fi
    else resolve_auth; fi
    prepare_provider_assets
  fi
  launch_claude "$_main_model" "$_bypass_auth" "$@"
}

. "$LIB_DIR/commands.sh"
. "$LIB_DIR/unified.sh"
# Configuration can supply explicit policy without exporting arbitrary vars.
CROUTER_ALLOW_PAID_FALLBACK=${CROUTER_SESSION_PAID_FALLBACK:-${CROUTER_ALLOW_PAID_FALLBACK:-0}}
CROUTER_ALLOW_CROSS_MODEL_FALLBACK=${CROUTER_SESSION_CROSS_MODEL_FALLBACK:-${CROUTER_ALLOW_CROSS_MODEL_FALLBACK:-0}}
export CROUTER_ALLOW_PAID_FALLBACK CROUTER_ALLOW_CROSS_MODEL_FALLBACK
cmd=$1; shift
case $cmd in
  home)
    case ${1:-} in -h|--help) info 'usage: crouter (interactive terminal)'; exit 0 ;; esac
    [ $# -eq 0 ] || die 'home does not accept arguments'
    [ -n "$NODE_BIN" ] || die 'interactive home requires Node.js'
    exec "$NODE_BIN" "$LIB_DIR/home.js" "$ROOT_DIR" ;;
  _inventory) [ $# -eq 0 ] || die 'inventory does not accept arguments'; cmd_inventory ;;
  models)
    case ${1:-} in ''|-h|--help) info 'usage: crouter models <provider> [--list|--list-free|--current|--set <id>] [--refresh]'; exit 0 ;; esac
    load_provider "$1"; shift; catalog_run "$@" ;;
  help|-h|--help) usage ;;
  version|-V|--version) info "crouter $VERSION"; exit 0 ;;
  list)
    case ${1:-} in
      ''|--all|-a|-h|--help) cmd_list "$@" ;;
      keys)
        case ${2:-} in
          -h|--help) usage_list_keys ;;
          -*) die "list keys: unknown argument '$2' (try: crouter list keys <provider>)" ;;
          *) [ $# -eq 2 ] || die 'usage: crouter list keys <provider>'; cmd_list_keys "$2" ;;
        esac ;;
      -*) die "list: unknown argument '$1' (try: crouter list [--all])" ;;
      *) [ $# -eq 1 ] || die 'usage: crouter list keys <provider>'; cmd_list_keys "$1" ;;
    esac ;;
  doctor) [ $# -le 1 ] || die 'usage: crouter doctor [provider]'; cmd_doctor "${1:-}" ;;
  add)
    case ${1:-} in '') cmd_add_interactive ;; -h|--help) usage_add ;; -*) cmd_add_interactive "$@" ;; *) cmd_add_key "$@" ;; esac ;;
  remove) cmd_remove_key "$@" ;;
  provider)
    case ${1:-} in -h|--help) usage_provider; exit 0 ;; '') die 'provider: name a provider (try: crouter list)' ;; esac
    [ "${1:-}" = show ] && shift
    case ${1:-} in -h|--help) usage_provider; exit 0 ;; '') die 'provider: name a provider (try: crouter list)' ;; esac
    [ $# -eq 1 ] || die 'usage: crouter provider show <provider>'
    cmd_provider_show "$1" ;;
  config)
    case ${1:-} in
      ''|show)
        case ${2:-} in -h|--help) usage_config ;; '') cmd_config_show ;; *) die "config: unexpected argument '$2' (try: crouter config show|path)" ;; esac ;;
      path)
        case ${2:-} in -h|--help) usage_config ;; '') cmd_config_path ;; *) die "config: unexpected argument '$2' (try: crouter config show|path)" ;; esac ;;
      -h|--help) usage_config ;;
      *) die "config: unknown argument '$1' (try: crouter config show|path)" ;;
    esac ;;
  logs)
    case ${1:-} in
      ''|list)
        case ${2:-} in -h|--help) usage_logs ;; '') cmd_logs_list ;; *) die "logs: unexpected argument '$2' (try: crouter logs list|tail)" ;; esac ;;
      tail) [ $# -eq 2 ] || die 'usage: crouter logs tail <provider>'; cmd_logs_tail "$2" ;;
      -h|--help) usage_logs ;;
      *) die "logs: unknown argument '$1' (try: crouter logs list|tail)" ;;
    esac ;;
  uninstall) cmd_uninstall "$@" ;;
  claude) cmd_claude "$@" ;;
  all) cmd_all "$@" ;;
  *) cmd_run "$cmd" "$@" ;;
esac
