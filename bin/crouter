#!/bin/sh
# crouter - unified launcher for Claude Code against multiple providers.
#
# Usage:
#   crouter <provider> [<model>] [claude args...]   Launch (optional positional model)
#   crouter all                           Unified gateway: one URL, switch providers via /model
#   crouter list                          List available providers
#   crouter doctor [provider]             Run environment diagnostics
#   crouter add <provider>                Add a key to a provider's keychain keypool
#   crouter remove <provider>             Remove a key from the keypool (and Keychain)
#   crouter list keys <provider>          List keys registered for a provider
#   crouter provider show <provider>      Show full provider config (secrets redacted)
#   crouter config show                   Show effective configuration
#   crouter config path                   Show path to config.sh
#   crouter logs list                     List files under the log directory
#   crouter logs tail <provider>          tail -f the provider's log file
#   crouter uninstall [-y]                Remove symlinks from $INSTALL_DIR
#   crouter help                          Show this help
#   crouter --version                     Show version
#
# Providers live in providers/<name>.sh and only declare "how to connect".
# This entry point owns "how to launch safely and portably".

set -u

# ---------------------------------------------------------------------------
# Locate ourselves (follow symlinks so a ~/.local/bin link still finds ROOT_DIR)
# ---------------------------------------------------------------------------
SELF=$0
while [ -h "$SELF" ]; do
  self_dir=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
  link=$(readlink "$SELF")
  case $link in
    /*) SELF=$link ;;
    *)  SELF=$self_dir/$link ;;
  esac
done
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
PROVIDERS_DIR=$ROOT_DIR/providers
LIB_DIR=$ROOT_DIR/lib

# ---------------------------------------------------------------------------
# Version (single source of truth: $ROOT_DIR/VERSION)
# ---------------------------------------------------------------------------
VERSION=$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'unknown')

# ---------------------------------------------------------------------------
# Config (optional, gitignored). config.example.sh documents the knobs.
# ---------------------------------------------------------------------------
CLAUDE_BIN=${CLAUDE_BIN:-}
LOG_DIR=${LOG_DIR:-$ROOT_DIR/logs}
STATE_DIR=${STATE_DIR:-$ROOT_DIR/.state}
if [ -f "$ROOT_DIR/config.sh" ]; then
  . "$ROOT_DIR/config.sh"
fi
if [ -z "$CLAUDE_BIN" ]; then
  CLAUDE_BIN=$(command -v claude 2>/dev/null || true)
fi
NODE_BIN=${NODE_BIN:-$(command -v node 2>/dev/null || true)}

die() { printf 'crouter: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

usage() {
  sed -n '2,18p' "$SELF" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------------------
# Modular helpers (sourced after core globals are set). Each lib is a set of
# POSIX functions that read globals only at call time.
# ---------------------------------------------------------------------------
for _mod in provider auth key-mgmt launch; do
  . "$LIB_DIR/$_mod.sh"
done


# ---------------------------------------------------------------------------
# Hooks
# ---------------------------------------------------------------------------
run_pre_start() {
  [ -n "$PRE_START" ] || return 0
  eval "$PRE_START" || die "PRE_START hook failed for '$PROVIDER_NAME'"
}

# POST_STOP has no wrapper here on purpose: lib/launch.sh evaluates it directly
# from its exit trap, which is the only place it can run after Claude Code exits.

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_run() {
  _p=$1; shift
  load_provider "$_p"

  # Resolve the primary model with this precedence:
  #   --model <x>  >  first bare positional (short form)  >  provider MODEL
  # A bare positional model is only taken if it appears BEFORE any flag, so it
  # never collides with a flag's own value (e.g. `crouter ollama -p "prompt"`).
  # An ANTHROPIC_MODEL exported in the shell (e.g. from ~/.zshrc as a leftover
  # MiniMax default) is a leftover we deliberately ignore here: launch.sh's
  # `env -i` keeps it out of the Claude child, and the chosen provider's MODEL
  # is authoritative. Pass --model to override explicitly.
  _main_model=""
  _model_set=0
  _pos_model=""
  _pos_idx=0
  _seen_flag=0
  _n=$#
  _i=0

  # Parse args without eval (avoids breaking on single quotes in arguments).
  # Save original args in a temporary file, then parse by reading it back.
  # This avoids eval and preserves all quoting exactly.
  _tmp_args=$(mktemp -t crouter_args.XXXXXX)
  trap 'rm -f "$_tmp_args"' EXIT INT TERM
  printf '%s\n' "$@" > "$_tmp_args"

  # Parse saved args to find model and positional model index
  _i=0
  while IFS= read -r _a; do
    _i=$((_i + 1))
    case "$_a" in
      --model=*)
        _main_model=${_a#--model=}; _model_set=1; _seen_flag=1 ;;
      --model)
        # Next line is the model value; if missing, treat as flag and let next iteration handle
        IFS= read -r _main_model || _main_model=
        _i=$((_i + 1))
        [ -n "$_main_model" ] && { _model_set=1; _seen_flag=1; } ;;
      -*)
        _seen_flag=1 ;;
      *)
        if [ "$_seen_flag" -eq 0 ] && [ -z "$_pos_model" ]; then
          _pos_model=$_a; _pos_idx=$_i
        fi ;;
    esac
  done < "$_tmp_args"

  # Rebuild $@ from saved args, skipping the positional model if found
  if [ "$_pos_idx" -gt 0 ]; then
    set --
    _i=0
    while IFS= read -r _a; do
      _i=$((_i + 1))
      if [ $_i -ne $_pos_idx ]; then
        set -- "$@" "$_a"
      fi
    done < "$_tmp_args"
  fi

  rm -f "$_tmp_args"
  trap - EXIT INT TERM

  # Explicit --model wins; otherwise use the positional shorthand, then the
  # provider default. Apply any provider-owned context rule to that exact model.
  if [ "$_model_set" -eq 0 ]; then
    _main_model=${_pos_model:-$MODEL}
  fi
  apply_model_context_override "$_main_model"

  AUTH_TOKEN=""
  _bypass_auth=0
  for _arg in "$@"; do
    case "$_arg" in
      --version|-V|--help|-h) _bypass_auth=1 ;;
    esac
  done

  if [ "$_bypass_auth" -eq 0 ]; then
    run_pre_start
    if is_dual_source; then
      # Preferred "default account" first; when the fallback API key is also
      # configured, front both with the local proxy so 401/429 rotates live.
      resolve_dual_source
      start_dual_failover
    elif [ "${AUTH_MODE:-}" = "keypool" ]; then
      # Auto-degrade: if AUTH_KEYS has exactly one key and there's no PLUS_KEYS,
      # bypass the keypool-proxy and use the single key directly. Avoids spinning
      # up a Node proxy for what is effectively a single-key session.
      _main_count=$(set -- $AUTH_KEYS; echo $#)
      _plus_count=$(set -- ${PLUS_KEYS:-}; echo $#)
      if [ "$_main_count" -eq 1 ] && [ "$_plus_count" -eq 0 ]; then
        AUTH_REFERENCE=$(set -- $AUTH_KEYS; printf '%s' "$1")
        AUTH_MODE=keychain
        resolve_auth
      else
        start_keypool
      fi
    else
      resolve_auth
    fi
  fi

  launch_claude "$_main_model" "$_bypass_auth" "$@"
}

cmd_list() {
  if [ -n "${1:-}" ]; then
    cmd_list_keys_one "$1"
    return
  fi
  printf '%-22s %-26s %-11s %s\n' 'PROVIDER' 'DEFAULT MODEL' 'AUTH' 'ENDPOINT'
  for _n in $(provider_names); do
    (
      load_provider "$_n"
      if is_dual_source; then
        if [ -n "${DEFAULT_TOKEN_ENV:-}" ]; then _am="dual"; else _am="apikey"; fi
      else
        _am="$AUTH_MODE"
      fi
      printf '%-22s %-26s %-11s %s\n' "$_n" "$MODEL" "$_am" "$BASE_URL"
    )
  done
}

status_one() {
  (
    load_provider "$1"
    if check_auth; then
      _auth=ok
      # Dual-source: surface which credential(s) are live (default / api / both).
      if is_dual_source; then _auth="ok($(dual_source_state))"; fi
    else
      _auth=MISSING
    fi
    if [ -n "$HEALTH_CHECK_URL" ]; then
      if check_health; then _health=up; else _health=DOWN; fi
    else
      _health='-'
    fi
    printf '%-22s auth:%-9s health:%-6s %s\n' "$1" "$_auth" "$_health" "$BASE_URL"
  )
}

cmd_doctor() {
  _fail=0

  if [ -n "$CLAUDE_BIN" ] && [ -x "$CLAUDE_BIN" ]; then
    info "ok    claude binary: $CLAUDE_BIN"
  else
    info "FAIL  claude binary not found (set CLAUDE_BIN in config.sh)"; _fail=1
  fi

  if [ -f "$ROOT_DIR/config.sh" ]; then
    info "ok    config: $ROOT_DIR/config.sh"
  else
    info "note  no config.sh (using defaults; copy config.example.sh if needed)"
  fi

  if command -v curl >/dev/null 2>&1; then
    info "ok    curl available"
  else
    info "FAIL  curl missing"; _fail=1
  fi
  if command -v security >/dev/null 2>&1; then
    info "ok    macOS keychain (security) available"
  else
    info "note  'security' missing (keychain providers unavailable)"
  fi

  info ""
  if [ -n "${1:-}" ]; then
    status_one "$1"
  else
    for _n in $(provider_names); do status_one "$_n"; done
  fi
  return $_fail
}


# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift

# cmd_provider_show <provider>
#   Print the full provider configuration with secrets redacted.
cmd_provider_show() {
  _p=$1
  load_provider "$_p"
  _file=$(provider_file "$_p")

  printf 'provider:    %s\n' "$_p"
  printf 'description: %s\n' "${PROVIDER_DESC:-<none>}"
  printf 'config file: %s\n' "$_file"
  printf '\n'
  printf 'endpoint:    %s\n' "$BASE_URL"
  printf 'default:     %s\n' "$MODEL"
  printf 'context:     %s tokens\n' "${CONTEXT_TOKENS:-<unset>}"
  printf 'effort:      %s\n' "${EFFORT:-<unset>}"
  printf '\n'
  printf 'aliases:\n'
  printf '  opus:      %s\n'    "$MODEL_OPUS"
  printf '  sonnet:    %s\n'    "$MODEL_SONNET"
  printf '  haiku:     %s\n'    "$MODEL_HAIKU"
  printf '  subagent:  %s\n'    "$MODEL_SUBAGENT"
  if [ -n "${MODEL_ALIASES:-}" ]; then
    printf '  extras:    %s\n' "$MODEL_ALIASES"
  fi
  printf '\n'
  if is_dual_source; then
    if [ -n "${DEFAULT_TOKEN_ENV:-}" ]; then
      printf 'auth:        dual-source (default account first, API key on 401/429)\n'
      printf '  default:   %s\n' "${DEFAULT_URL:-$BASE_URL}"
      printf '    type:    %s\n' "${DEFAULT_AUTH_TYPE:-bearer}"
      printf '    token:   $%s%s\n' "$DEFAULT_TOKEN_ENV" \
        "$([ -n "${DEFAULT_TOKEN_ENV_FALLBACK:-}" ] && printf ' (or $%s)' "$DEFAULT_TOKEN_ENV_FALLBACK")"
    else
      printf 'auth:        api key\n'
    fi
    printf '  api:       %s\n' "${API_URL:-$BASE_URL}"
    printf '    type:    %s\n' "${API_AUTH_TYPE:-x-api-key}"
    printf '    key:     $%s%s\n' "${API_KEY_ENV:-<unset>}" \
      "$([ -n "${API_KEY_REF:-}" ] && printf ' (or keychain %s)' "$API_KEY_REF")"
    printf '  live now:  %s\n' "$(_s=$(dual_source_state); printf '%s' "${_s:-<none configured>}")"
    _skip_auth_case=1
  else
    _skip_auth_case=0
    printf 'auth:        %s\n' "$AUTH_MODE"
  fi
  [ "$_skip_auth_case" -eq 1 ] || case "$AUTH_MODE" in
    keychain) printf '  reference: %s\n' "$AUTH_REFERENCE" ;;
    env)      printf '  reference: %s\n' "$AUTH_REFERENCE" ;;
    command)  printf '  reference: %s\n' "$AUTH_REFERENCE" ;;
    static)   printf '  reference: %s (literal placeholder)\n' "$AUTH_REFERENCE" ;;
    none)     ;;
    keypool)
      printf '  AUTH_KEYS:      %s\n' "${AUTH_KEYS:-<empty>}"
      if [ -n "${PLUS_URL:-}" ]; then
        printf '  PLUS_URL: %s\n' "$PLUS_URL"
        printf '  PLUS_KEYS:     %s\n' "${PLUS_KEYS:-<empty>}"
      fi
      ;;
  esac
  if [ -n "$EXTRA_ENV" ]; then
    printf '\nextra env:\n'
    _old_ifs=$IFS; IFS='
'; for _pair in $EXTRA_ENV; do printf '  %s\n' "$_pair"; done; IFS=$_old_ifs
  fi
  if [ -n "$PRE_START" ] || [ -n "$POST_STOP" ] || [ -n "$HEALTH_CHECK_URL" ]; then
    printf '\nhooks:\n'
    [ -n "$PRE_START" ]       && printf '  PRE_START:        %s\n' "$PRE_START"
    [ -n "$POST_STOP" ]       && printf '  POST_STOP:        %s\n' "$POST_STOP"
    [ -n "$HEALTH_CHECK_URL" ] && printf '  HEALTH_CHECK_URL: %s\n' "$HEALTH_CHECK_URL"
  fi
}

# cmd_config_path
#   Print the absolute path to the active config.sh (or note its absence).
cmd_config_path() {
  if [ -f "$ROOT_DIR/config.sh" ]; then
    printf '%s\n' "$ROOT_DIR/config.sh"
  else
    printf 'no config.sh (using built-in defaults; copy %s/config.example.sh to %s/config.sh to override)\n' "$ROOT_DIR" "$ROOT_DIR"
    return 1
  fi
}

# cmd_config_show
#   Print effective configuration knobs. Lines that look like KEY=VALUE get the
#   value redacted if its variable name contains KEY/TOKEN/SECRET.
cmd_config_show() {
  printf 'ROOT_DIR:      %s\n' "$ROOT_DIR"
  printf 'VERSION:       %s\n' "$VERSION"
  printf 'INSTALL_DIR:   %s\n' "${INSTALL_DIR:-$HOME/.local/bin}"
  printf 'LOG_DIR:       %s\n' "${LOG_DIR:-$ROOT_DIR/logs}"
  printf 'STATE_DIR:     %s\n' "${STATE_DIR:-$ROOT_DIR/.state}"
  printf 'CLAUDE_BIN:    %s\n' "${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo '<not found>')}"
  printf 'NODE_BIN:      %s\n' "${NODE_BIN:-$(command -v node 2>/dev/null || echo '<not found>')}"
  printf '\n'
  if [ -f "$ROOT_DIR/config.sh" ]; then
    printf 'config.sh source (sensitive values redacted):\n'
    while IFS= read -r _line; do
      case "$_line" in
        ''|'#'*) printf '  %s\n' "$_line" ;;
        *=*)
          _name=${_line%%=*}
          case "$_name" in
            *KEY*|*TOKEN*|*SECRET*|*PASSWORD*)
              printf '  %s=<redacted>\n' "$_name" ;;
            *) printf '  %s\n' "$_line" ;;
          esac
          ;;
        *) printf '  %s\n' "$_line" ;;
      esac
    done < "$ROOT_DIR/config.sh"
  else
    printf 'no config.sh (using built-in defaults)\n'
  fi
}

# cmd_logs_list
#   Print each entry under $LOG_DIR with size and mtime.
cmd_logs_list() {
  _ld=${LOG_DIR:-$ROOT_DIR/logs}
  if [ ! -d "$_ld" ]; then
    info "no logs directory: $_ld"; return 0
  fi
  _any=0
  for _f in "$_ld"/*; do
    [ -e "$_f" ] || continue
    _any=1
    printf '%10s  %s  %s\n' \
      "$(ls -l "$_f" | awk '{print $5}')" \
      "$(ls -l "$_f" | awk '{print $6, $7, $8}')" \
      "$_f"
  done
  if [ "$_any" -eq 0 ]; then info "(no logs yet)"; fi
}

# cmd_logs_tail <provider>
#   tail -f the most likely log file for that provider.
cmd_logs_tail() {
  _p=$1
  _ld=${LOG_DIR:-$ROOT_DIR/logs}
  _found=
  for _candidate in "$_ld/$_p.log" "$_ld/keypool-$_p.log" "$_ld/$_p-proxy.log"; do
    if [ -f "$_candidate" ]; then _found=$_candidate; break; fi
  done
  if [ -z "$_found" ]; then
    die "no log file for provider '$_p' under $_ld"
  fi
  info "tailing $_found (Ctrl-C to exit)"
  tail -n 50 -F "$_found"
}

# cmd_uninstall [-y]
#   Reverse of install.sh: remove the crouter + claude-<provider> symlinks.
cmd_uninstall() {
  _yes=0
  while [ $# -gt 0 ]; do
    case $1 in
      -y|--yes) _yes=1; shift ;;
      -h|--help) info "usage: crouter uninstall [-y]"; return 0 ;;
      *) die "uninstall: unknown argument '$1'" ;;
    esac
  done
  _dir=${INSTALL_DIR:-$HOME/.local/bin}
  # Same derivation as install.sh: one claude-<provider> shortcut per provider
  # file, so a new provider is uninstalled without editing this list.
  _targets="crouter"
  for _pf in "$PROVIDERS_DIR"/*.sh; do
    [ -f "$_pf" ] || continue
    _targets="$_targets claude-$(basename "$_pf" .sh)"
  done

  if [ "$_yes" -eq 0 ]; then
    printf 'remove crouter and provider shortcuts from %s? [y/N] ' "$_dir" >/dev/tty
    _ans=
    IFS= read -r _ans </dev/tty || _ans=
    case "$_ans" in y|Y|yes|YES) ;; *) info "aborted"; return 0 ;; esac
  fi

  for _t in $_targets; do
    if [ -L "$_dir/$_t" ] || [ -e "$_dir/$_t" ]; then
      rm -f "$_dir/$_t" && info "removed $_dir/$_t"
    fi
  done
}

# ---------------------------------------------------------------------------
# Unified gateway: crouter all
# Starts a single local Anthropic-protocol gateway that fronts every provider.
# Claude Code points at one fixed URL; the model name carries a "<provider>/"
# prefix and the gateway routes to the right backend with that backend's auth.
# GET /v1/models returns the combined, namespaced catalog so /model can switch
# providers live. Each provider's separate command (crouter ollama, etc.) is
# untouched and still launches directly.
# ---------------------------------------------------------------------------

# Build a routes JSON file covering every provider. Prints the temp file path.
# Credential discovery lives here (shell owns Keychain/env); the JSON shapes
# live in lib/route-build.js.
build_all_routes() {
  _rt=$(mktemp -t call-routes.XXXXXX)
  for _n in $(provider_names); do
    (
      load_provider "$_n"
      # keypool: every key (main + plus) becomes its own candidate, rotated on 401/429.
      _kpool=""
      _plus_pool=""
      if [ "${AUTH_MODE:-}" = "keypool" ]; then
        for _ref in ${AUTH_KEYS:-}; do
          _t=$(kc_get "$_ref")
          [ -n "$_t" ] && _kpool="$_kpool $_t"
        done
        if [ -n "${PLUS_URL:-}" ] && [ -n "${PLUS_KEYS:-}" ]; then
          for _ref in ${PLUS_KEYS:-}; do
            _t=$(kc_get "$_ref")
            [ -n "$_t" ] && _plus_pool="$_plus_pool $_t"
          done
        fi
      fi
      # API-surface credential (env var, then keychain service, then legacy AUTH_*).
      _api_key=""
      if [ -n "${API_KEY_ENV:-}" ] && [ -n "$(printenv "$API_KEY_ENV" 2>/dev/null)" ]; then
        _api_key=$(printenv "$API_KEY_ENV")
      elif [ -n "${API_KEY_REF:-}" ]; then
        _api_key=$(kc_get "$API_KEY_REF")
      else
        case "${AUTH_MODE:-}" in
          keychain) [ -n "${AUTH_REFERENCE:-}" ] && _api_key=$(kc_get "$AUTH_REFERENCE") ;;
          env)      [ -n "${AUTH_REFERENCE:-}" ] && _api_key=$(printenv "$AUTH_REFERENCE" 2>/dev/null) ;;
          command)  [ -n "${AUTH_REFERENCE:-}" ] && _api_key=$(eval "$AUTH_REFERENCE" 2>/dev/null) ;;
          static)   _api_key="${AUTH_REFERENCE:-}" ;;
        esac
      fi
      # DEFAULT-surface token (subscription OAuth, or a configured gateway token).
      _def_token=""
      if [ -n "${DEFAULT_TOKEN_ENV:-}" ] && [ -n "$(printenv "$DEFAULT_TOKEN_ENV" 2>/dev/null)" ]; then
        _def_token=$(printenv "$DEFAULT_TOKEN_ENV")
      elif [ -n "${DEFAULT_TOKEN_ENV_FALLBACK:-}" ] && [ -n "$(printenv "$DEFAULT_TOKEN_ENV_FALLBACK" 2>/dev/null)" ]; then
        _def_token=$(printenv "$DEFAULT_TOKEN_ENV_FALLBACK")
      fi
      # none-mode dummy token(s) from EXTRA_ENV (ollama), split on newline OR ';'.
      _te=""; _extra=""
      if [ "${AUTH_MODE:-}" = "none" ]; then
        _ifs="$IFS"; IFS='
;'
        for _kv in ${EXTRA_ENV:-}; do
          [ -n "$_kv" ] || continue
          case "$_kv" in ANTHROPIC_AUTH_TOKEN=*) _te=${_kv#ANTHROPIC_AUTH_TOKEN=} ;; esac
          _extra="$_extra $_kv"
        done
        IFS="$_ifs"
      fi
      # Candidate models: default first, then the tier aliases, then whatever is
      # pulled locally for ollama. route-build.js dedups and keeps this order.
      _models="${MODEL:-} ${MODEL_OPUS:-} ${MODEL_SONNET:-} ${MODEL_HAIKU:-} ${MODEL_SUBAGENT:-}"
      if [ "$PROVIDER_NAME" = "ollama" ] && command -v ollama >/dev/null 2>&1; then
        _models="$_models $(ollama list 2>/dev/null | awk 'NR>1{print $1}')"
      fi

      CR_PREFIX="$PROVIDER_NAME" CR_MODELS="$_models" CR_KEYPOOL_KEYS="$_kpool" \
      CR_PLUS_KEYS="$_plus_pool" CR_PLUS_URL="${PLUS_URL:-}" \
      CR_DEFAULT_URL="${DEFAULT_URL:-$BASE_URL}" CR_DEFAULT_TYPE="${DEFAULT_AUTH_TYPE:-}" CR_DEFAULT_TOKEN="$_def_token" \
      CR_API_URL="${API_URL:-$BASE_URL}" CR_API_TYPE="${API_AUTH_TYPE:-}" CR_API_KEY="$_api_key" \
      CR_AUTH_MODE="${AUTH_MODE:-}" CR_AUTH_SCHEME="${_AUTH_SCHEME:-}" \
      CR_NONE_TOKEN="$_te" CR_NONE_EXTRA="$_extra" \
        "$NODE_BIN" "$LIB_DIR/route-build.js" candidates
    ) >> "$_rt"
  done
  _arr=$(mktemp -t call-routes-arr.XXXXXX)
  "$NODE_BIN" "$LIB_DIR/route-build.js" combine "$_rt" "$_arr"
  rm -f "$_rt"
  echo "$_arr"
}

_default_namespaced_model() {
  "$NODE_BIN" "$LIB_DIR/route-build.js" default-model "$1"
}

cmd_all() {
  [ -n "$NODE_BIN" ] || die "node not found; unified gateway cannot start"
  _gwpid=""
  trap 'kill "${_gwpid:-}" 2>/dev/null' EXIT INT TERM
  _routes_file=$(build_all_routes)
  [ -s "$_routes_file" ] || die "no providers found to build the gateway"
  _out=$(mktemp -t call-gw.XXXXXX)
  CROUTER_ROUTES_FILE="$_routes_file" CROUTER_GATEWAY_PORT="${CROUTER_GATEWAY_PORT:-18799}" \
    "$NODE_BIN" "$BIN_DIR/gateway" > "$_out" 2>/dev/null &
  _gwpid=$!
  _port=""
  _i=0
  while [ $_i -lt 50 ]; do
    _port=$(grep -m1 '^CROUTER_GATEWAY_LISTENING_PORT=' "$_out" 2>/dev/null | cut -d= -f2)
    [ -n "$_port" ] && break
    kill -0 "$_gwpid" 2>/dev/null || break
    sleep 0.1
    _i=$((_i + 1))
  done
  if [ -z "$_port" ]; then
    rm -f "$_out" "$_routes_file"
    die "unified gateway failed to start"
  fi
  rm -f "$_out"
  info "crouter all: unified gateway on http://127.0.0.1:$_port — switch providers with /model <provider>/<model>"
  # Launch Claude Code pointed at the gateway (single fixed URL).
  GATEWAY_PID="$_gwpid"
  POST_STOP="kill \"\$GATEWAY_PID\" 2>/dev/null; rm -f \"$_routes_file\" 2>/dev/null"
  _def=$(_default_namespaced_model "$_routes_file")
  BASE_URL="http://127.0.0.1:$_port"
  MODEL="$_def"; MODEL_OPUS="$_def"; MODEL_SONNET="$_def"; MODEL_HAIKU="$_def"; MODEL_SUBAGENT="$_def"
  AUTH_MODE="none"
  AUTH_TOKEN=""
  CONTEXT_TOKENS=""
  EXTRA_ENV="ANTHROPIC_AUTH_TOKEN=crouter"
  _bypass_auth=0
  launch_claude "$_def" "$_bypass_auth" "$@"
}

case $cmd in
  help|-h|--help) usage ;;
  version|-V|--version) info "crouter $VERSION"; exit 0 ;;
  list)
    case "${1:-}" in
      keys)  # back-compat: crouter list keys <provider>
        [ $# -ge 2 ] || die "usage: crouter list keys <provider>"
        shift; cmd_list_keys_one "$1" ;;
      "")     cmd_list ;;
      *)      cmd_list_keys_one "$1" ;;
    esac ;;
  key)          cmd_key ;;                    # 交互式密钥管理（中文菜单）
  doctor)       cmd_doctor "${1:-}" ;;
  add)          [ $# -ge 1 ] || die "usage: crouter add <provider> [--surface main|plus] [--name <service>]"; cmd_add_key "$@" ;;
  remove)       [ $# -ge 1 ] || die "usage: crouter remove <provider> --name <service> [--surface main|plus]"; cmd_remove_key "$@" ;;
  provider)
    [ "${1:-}" = show ] && shift
    [ $# -ge 1 ] || die "usage: crouter provider show <provider>"
    cmd_provider_show "$1" ;;
  config)
    if [ "${1:-}" = path ]; then
      cmd_config_path
    else
      cmd_config_show
    fi ;;
  logs)
    if [ "${1:-}" = tail ]; then
      [ $# -ge 2 ] || die "usage: crouter logs tail <provider>"
      cmd_logs_tail "$2"
    else
      cmd_logs_list
    fi ;;
  uninstall)    cmd_uninstall "$@" ;;
  all)          cmd_all "$@" ;;
  *)            cmd_run "$cmd" "$@" ;;
esac
