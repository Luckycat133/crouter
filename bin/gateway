#!/usr/bin/env node
// crouter unified gateway: a tiny, dependency-free local Anthropic-protocol
// router. Claude Code points ANTHROPIC_BASE_URL at this gateway (one fixed
// URL); the model name carries a provider prefix (e.g. "ollama/qwen3.5:2b",
// "anthropic/claude-sonnet-4") and the gateway forwards each request to the
// right backend with that backend's own auth. GET /v1/models returns the
// combined, namespaced model catalog so Claude Code's /model can switch
// providers live.
//
// Route model (v2: candidates)
//   A route has one or more `candidates`. Each candidate is a complete auth
//   surface: its own `url` and `auth` ({type, token}) plus optional
//   `extra_env` (header K=V pairs). The gateway tries candidates in order and
//   fails over to the next one on HTTP 401/429. This is what makes
//   "preferred account first, API key fallback" work at request granularity:
//   e.g. Anthropic's route has candidate[0] = subscription OAuth (Bearer) and
//   candidate[1] = API key (x-api-key). Keypool providers simply list every
//   key as its own candidate, so 429 rotation is the same mechanism.
//
// Env contract:
//   CROUTER_ROUTES_FILE  path to a JSON file: an array of route objects
//   CROUTER_GATEWAY_PORT port to listen on (default 18799)
//   CROUTER_GATEWAY_TOKEN token Claude Code must send (accepted if non-empty;
//                         default "crouter"). The gateway is local-only.
//
// Route object:
//   { "prefix": "anthropic",
//     "base_url": "https://api.anthropic.com",
//     "candidates": [
//       { "url": "...", "auth": {"type":"bearer","token":"<oauth>"}, "extra_env": [] },
//       { "url": "...", "auth": {"type":"x-api-key","token":"<key>"}, "extra_env": [] }
//     ],
//     "models": ["claude-sonnet-4", ...] }

'use strict';
const http = require('http');
const https = require('https');
const fs = require('fs');
const { URL } = require('url');

function fail(msg) {
  process.stderr.write('crouter-gateway: ' + msg + '\n');
  process.exit(1);
}

const routesFile = process.env.CROUTER_ROUTES_FILE;
if (!routesFile) fail('CROUTER_ROUTES_FILE not set');
let raw;
try {
  raw = fs.readFileSync(routesFile, 'utf8');
} catch (e) {
  fail('cannot read routes file ' + routesFile + ': ' + e.message);
}
let ROUTES;
try {
  ROUTES = JSON.parse(raw);
} catch (e) {
  fail('routes file is not valid JSON: ' + e.message);
}
if (!Array.isArray(ROUTES) || ROUTES.length === 0) fail('routes must be a non-empty array');

const PORT = parseInt(process.env.CROUTER_GATEWAY_PORT || '18799', 10);
if (!Number.isInteger(PORT) || PORT < 1 || PORT > 65535) fail('CROUTER_GATEWAY_PORT invalid');
const GATEWAY_TOKEN = process.env.CROUTER_GATEWAY_TOKEN || 'crouter';

// Pre-parse each candidate's target.
for (const r of ROUTES) {
  if (!Array.isArray(r.candidates) || r.candidates.length === 0) {
    fail('route ' + r.prefix + ' has no candidates');
  }
  for (const c of r.candidates) {
    let u;
    try {
      u = new URL(c.url);
    } catch (e) {
      fail('bad candidate url for ' + r.prefix + ': ' + c.url);
    }
    if (u.protocol !== 'http:' && u.protocol !== 'https:') fail('only http/https: ' + c.url);
    c._proto = u.protocol;
    c._host = u.hostname;
    c._port = u.port || (u.protocol === 'https:' ? 443 : 80);
    c._pathBase = u.pathname.replace(/\/+$/, '');
    c.auth = c.auth || { type: 'none', token: '' };
  }
}

function routeByPrefix(prefix) {
  return ROUTES.find((r) => r.prefix === prefix);
}

function log(msg) {
  process.stderr.write('crouter-gateway: ' + msg + '\n');
}

// ---- header construction per candidate -----------------------------------
function buildHeaders(cand, clientReq) {
  const headers = {};
  for (const [h, v] of Object.entries(clientReq.headers)) {
    const lh = h.toLowerCase();
    if (lh === 'host' || lh === 'connection' || lh === 'proxy-connection') continue;
    if (lh === 'authorization' || lh === 'x-api-key') continue; // gateway sets auth
    headers[h] = v;
  }
  const a = cand.auth;
  if (a.type === 'none') {
    // Ollama-style: a dummy token (value ignored by backend) + optional extra_env.
    // Never send an empty credential header — some servers drop empty values.
    const tok = a.token || 'crouter';
    headers['anthropic-auth-token'] = tok;
    headers['x-api-key'] = tok;
    for (const kv of cand.extra_env || []) {
      const i = kv.indexOf('=');
      if (i < 0) continue;
      const h = kv.slice(0, i);
      const lh = h.toLowerCase();
      if (lh === 'host' || lh === 'connection' || lh === 'content-length' || lh === 'transfer-encoding') continue;
      headers[h] = kv.slice(i + 1);
    }
  } else if (a.type === 'x-api-key') {
    headers['x-api-key'] = a.token;
  } else if (a.type === 'bearer') {
    headers['authorization'] = 'Bearer ' + a.token;
  }
  // Body is rewritten (model prefix stripped); drop content-length and let Node recompute.
  delete headers['content-length'];
  delete headers['transfer-encoding'];
  return headers;
}

// ---- GET /v1/models -------------------------------------------------------
function handleModels(clientRes) {
  const data = [];
  for (const r of ROUTES) {
    for (const m of r.models) {
      data.push({ id: r.prefix + '/' + m, type: 'model', object: 'model' });
    }
  }
  const body = JSON.stringify({ object: 'list', data: data, has_more: false });
  clientRes.writeHead(200, { 'content-type': 'application/json' });
  clientRes.end(body);
}

// ---- POST /v1/messages ----------------------------------------------------
function handleMessage(clientReq, clientRes) {
  const chunks = [];
  let size = 0;
  clientReq.on('data', (c) => {
    chunks.push(c);
    size += c.length;
  });
  clientReq.on('end', () => {
    const body = Buffer.concat(chunks, size);
    let parsed;
    try {
      parsed = JSON.parse(body.toString('utf8'));
    } catch (e) {
      clientRes.writeHead(400, { 'content-type': 'application/json' });
      clientRes.end(JSON.stringify({ error: { type: 'invalid_request', message: 'body is not JSON' } }));
      return;
    }
    const model = parsed.model || '';
    const slash = model.indexOf('/');
    if (slash < 0) {
      clientRes.writeHead(400, { 'content-type': 'application/json' });
      clientRes.end(
        JSON.stringify({
          error: {
            type: 'unknown_model',
            message:
              'model "' + model + '" has no provider prefix. Use "<provider>/<model>" (providers: ' +
              ROUTES.map((r) => r.prefix).join(', ') + ').',
          },
        })
      );
      return;
    }
    const prefix = model.slice(0, slash);
    const realModel = model.slice(slash + 1);
    const route = routeByPrefix(prefix);
    if (!route) {
      clientRes.writeHead(400, { 'content-type': 'application/json' });
      clientRes.end(
        JSON.stringify({ error: { type: 'unknown_provider', message: 'no such provider prefix: ' + prefix } })
      );
      return;
    }
    // Rewrite the model to the backend's bare name, then forward.
    parsed.model = realModel;
    const newBody = Buffer.from(JSON.stringify(parsed), 'utf8');

    // Try candidates in order; fail over on 401/429 or upstream error.
    function tryCand(idx) {
      if (idx >= route.candidates.length) {
        if (!clientRes.headersSent) {
          clientRes.writeHead(502, { 'content-type': 'application/json' });
          clientRes.end(
            JSON.stringify({
              error: { type: 'all_candidates_failed', message: 'all auth candidates for ' + prefix + ' failed' },
            })
          );
        }
        return;
      }
      const cand = route.candidates[idx];
      const headers = buildHeaders(cand, clientReq);
      const path = cand._pathBase + (clientReq.url || '/');
      const options = {
        protocol: cand._proto,
        host: cand._host,
        port: cand._port,
        method: clientReq.method,
        path: path,
        headers: headers,
      };
      const transport = cand._proto === 'https:' ? https : http;
      const up = transport.request(options, (upRes) => {
        const status = upRes.statusCode;
        // Failover on 401 (auth failure), 429 (rate limit), and 5xx (server errors)
        const transient = status === 401 || status === 429 || (status >= 500 && status < 600);
        if (transient && idx + 1 < route.candidates.length) {
          log('candidate ' + idx + ' on ' + prefix + ' got ' + status + ' -> failing over');
          upRes.resume(); // drain, do not pipe
          tryCand(idx + 1);
          return;
        }
        if (!clientRes.headersSent) clientRes.writeHead(upRes.statusCode, upRes.headers);
        upRes.pipe(clientRes);
      });
      up.on('error', (e) => {
        log('upstream error (' + prefix + ' cand ' + idx + '): ' + e.message);
        if (idx + 1 < route.candidates.length) {
          tryCand(idx + 1);
        } else if (!clientRes.headersSent) {
          clientRes.writeHead(502, { 'content-type': 'application/json' });
          clientRes.end(JSON.stringify({ error: { type: 'upstream_error', message: e.message } }));
        }
      });
      if (newBody && newBody.length) up.write(newBody);
      up.end();
    }
    tryCand(0);
  });
  clientReq.on('error', () => {
    if (!clientRes.headersSent) clientRes.writeHead(400).end('client error');
  });
}

const server = http.createServer((req, res) => {
  if (req.method === 'GET' && req.url.split('?')[0] === '/v1/models') {
    handleModels(res);
    return;
  }
  if (req.method === 'POST' && req.url.split('?')[0] === '/v1/messages') {
    handleMessage(req, res);
    return;
  }
  res.writeHead(404, { 'content-type': 'application/json' });
  res.end(JSON.stringify({ error: { type: 'not_found', message: 'only /v1/messages and /v1/models are served' } }));
});

server.listen(PORT, '127.0.0.1', () => {
  const actual = server.address().port;
  process.stdout.write('CROUTER_GATEWAY_LISTENING_PORT=' + actual + '\n');
  log(
    'listening on 127.0.0.1:' + actual + ' | providers=' + ROUTES.map((r) => r.prefix).join(',') +
      ' | models=' + ROUTES.reduce((a, r) => a + r.models.length, 0)
  );
});

function shutdown() {
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(0), 500).unref();
}
process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);
