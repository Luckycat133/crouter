#!/usr/bin/env node
// crouter unified gateway: a tiny, dependency-free local Anthropic-protocol
// router. Claude Code points ANTHROPIC_BASE_URL at this gateway (one fixed
// URL); the model name carries a provider prefix (e.g. "ollama/qwen3.5:2b",
// "anthropic/claude-sonnet-4") and the gateway forwards each request to the
// right backend with that backend's own auth. GET /v1/models returns the
// combined, namespaced model catalog so Claude Code's /model can switch
// providers live.
//
// Route model (v2: candidates)
//   A route has one or more `candidates`. Each candidate is a complete auth
//   surface: its own `url`, `auth` ({type, token}), and optional model map. The
//   gateway tries candidates in order and
//   fails over to the next one on HTTP 401/402/403/429. Explicit billing
//   surfaces keep plan credentials and API keys bound to their own URL/header;
//   keypool providers simply list every key as its own candidate. Cross-request
//   cooldown keeps exhausted candidates out of the hot path temporarily.
//
// Env contract:
//   CROUTER_ROUTES_FILE  path to a JSON file: an array of route objects
//   CROUTER_GATEWAY_PORT port to listen on (default 18799)
//   CROUTER_GATEWAY_TOKEN token Claude Code must send on /v1/messages
//                         (default "crouter" for standalone compatibility).
//                         crouter generates a random token per session.
//
// Route object:
//   { "prefix": "anthropic",
//     "base_url": "https://api.anthropic.com",
//     "candidates": [
//       { "url": "...", "auth": {"type":"bearer","token":"<plan-key>"} },
//       { "url": "...", "auth": {"type":"x-api-key","token":"<key>"},
//         "model_map": {"logical model":"surface model"} }
//     ],
//     "models": ["claude-sonnet-4", ...] }

'use strict';
const http = require('http');
const https = require('https');
const fs = require('fs');
const { URL } = require('url');
const {
  applyAuth,
  createCandidateCooldown,
  forwardHeaders,
  isRetryableStatus,
  requestToken,
} = require('../lib/proxy-common.js');

function fail(msg) {
  process.stderr.write('crouter-gateway: ' + msg + '\n');
  process.exit(1);
}

const routesFile = process.env.CROUTER_ROUTES_FILE;
if (!routesFile) fail('CROUTER_ROUTES_FILE not set');
let raw;
try {
  raw = fs.readFileSync(routesFile, 'utf8');
} catch (e) {
  fail('cannot read routes file ' + routesFile + ': ' + e.message);
}
let ROUTES;
try {
  ROUTES = JSON.parse(raw);
} catch (e) {
  fail('routes file is not valid JSON: ' + e.message);
}
if (!Array.isArray(ROUTES) || ROUTES.length === 0) fail('routes must be a non-empty array');

const PORT = parseInt(process.env.CROUTER_GATEWAY_PORT || '18799', 10);
if (!Number.isInteger(PORT) || PORT < 1 || PORT > 65535) fail('CROUTER_GATEWAY_PORT invalid');
const GATEWAY_TOKEN = process.env.CROUTER_GATEWAY_TOKEN || 'crouter';

function rejectUnauthorized(res) {
  res.writeHead(401, {
    'content-type': 'application/json',
    'www-authenticate': 'Bearer realm="crouter-gateway"',
  });
  res.end(JSON.stringify({error: {type: 'authentication_error', message: 'invalid local gateway token'}}));
}

// Pre-parse each candidate's target.
for (const r of ROUTES) {
  if (!Array.isArray(r.candidates) || r.candidates.length === 0) {
    fail('route ' + r.prefix + ' has no candidates');
  }
  for (const c of r.candidates) {
    let u;
    try {
      u = new URL(c.url);
    } catch (e) {
      fail('bad candidate url for ' + r.prefix + ': ' + c.url);
    }
    if (u.protocol !== 'http:' && u.protocol !== 'https:') fail('only http/https: ' + c.url);
    c._proto = u.protocol;
    c._host = u.hostname;
    c._port = u.port || (u.protocol === 'https:' ? 443 : 80);
    c._pathBase = u.pathname.replace(/\/+$/, '');
    c.auth = c.auth || { type: 'none', token: '' };
  }
  try {
    r._candidateCooldown = createCandidateCooldown(
      r.candidates.length,
      process.env.CROUTER_CANDIDATE_COOLDOWN_MS,
    );
  } catch (error) {
    fail(error.message);
  }
}

function routeByPrefix(prefix) {
  return ROUTES.find((r) => r.prefix === prefix);
}

function log(msg) {
  process.stderr.write('crouter-gateway: ' + msg + '\n');
}

function candidateModel(cand, requested) {
  if (
    cand.model_map &&
    typeof cand.model_map === 'object' &&
    Object.prototype.hasOwnProperty.call(cand.model_map, requested)
  ) {
    return cand.model_map[requested];
  }
  // Compatibility with route files emitted before per-tier maps existed.
  return cand.model || requested;
}

// ---- header construction per candidate -----------------------------------
function buildHeaders(cand, clientReq) {
  const headers = forwardHeaders(clientReq.headers, true);
  const a = cand.auth;
  // `none` routes (Ollama) retain the documented dummy Bearer credential.
  return applyAuth(headers, a.type, a.token, true);
}

// ---- GET /v1/models -------------------------------------------------------
function handleModels(clientRes) {
  const data = [];
  for (const r of ROUTES) {
    for (const m of r.models) {
      data.push({ id: r.prefix + '/' + m, type: 'model', object: 'model' });
    }
  }
  const body = JSON.stringify({ object: 'list', data: data, has_more: false });
  clientRes.writeHead(200, { 'content-type': 'application/json' });
  clientRes.end(body);
}

// ---- POST /v1/messages ----------------------------------------------------
function handleMessage(clientReq, clientRes) {
  const chunks = [];
  let size = 0;
  clientReq.on('data', (c) => {
    chunks.push(c);
    size += c.length;
  });
  clientReq.on('end', () => {
    const body = Buffer.concat(chunks, size);
    let parsed;
    try {
      parsed = JSON.parse(body.toString('utf8'));
    } catch (e) {
      clientRes.writeHead(400, { 'content-type': 'application/json' });
      clientRes.end(JSON.stringify({ error: { type: 'invalid_request', message: 'body is not JSON' } }));
      return;
    }
    const model = parsed.model || '';
    const slash = model.indexOf('/');
    if (slash < 0) {
      clientRes.writeHead(400, { 'content-type': 'application/json' });
      clientRes.end(
        JSON.stringify({
          error: {
            type: 'unknown_model',
            message:
              'model "' + model + '" has no provider prefix. Use "<provider>/<model>" (providers: ' +
              ROUTES.map((r) => r.prefix).join(', ') + ').',
          },
        })
      );
      return;
    }
    const prefix = model.slice(0, slash);
    const realModel = model.slice(slash + 1);
    const route = routeByPrefix(prefix);
    if (!route) {
      clientRes.writeHead(400, { 'content-type': 'application/json' });
      clientRes.end(
        JSON.stringify({ error: { type: 'unknown_provider', message: 'no such provider prefix: ' + prefix } })
      );
      return;
    }
    // Try candidates in order; fail over on auth/quota errors or upstream error.
    // 5xx server errors and network blips are retried on the same candidate a few
    // times before failing over, so transient glitches don't immediately break
    // the request. 401/402/403/429 mean the candidate is exhausted: fail over
    // immediately without retrying.
    const candidateOrder = route._candidateCooldown.order();
    const MAX_CANDIDATE_RETRIES = 2;
    const RETRY_BACKOFF_MS = 400;
    function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }
    // Returns { kind: 'retry' } to retry same candidate, { kind: 'response', res }
    // for a final upstream response, or { kind: 'failover' } to try next candidate.
    function attemptCand(candidateIndex, attempt) {
      return new Promise((resolve) => {
        const cand = route.candidates[candidateIndex];
        // A surface may expose a provider-specific model for the same logical
        // route (for example a plan router versus a pay-as-you-go model ID).
        parsed.model = candidateModel(cand, realModel);
        const newBody = Buffer.from(JSON.stringify(parsed), 'utf8');
        const headers = buildHeaders(cand, clientReq);
        const path = cand._pathBase + (clientReq.url || '/');
        const options = {
          protocol: cand._proto,
          host: cand._host,
          port: cand._port,
          method: clientReq.method,
          path: path,
          headers: headers,
        };
        const transport = cand._proto === 'https:' ? https : http;
        const up = transport.request(options, (upRes) => {
          const status = upRes.statusCode;
          const authFailure = isRetryableStatus(status);
          const serverError = status >= 500 && status < 600;
          if (authFailure || serverError) route._candidateCooldown.fail(candidateIndex, upRes.headers);
          else route._candidateCooldown.clear(candidateIndex);
          if (authFailure) {
            // Exhausted candidate: fail over immediately, no retry.
            upRes.resume();
            resolve({ kind: 'failover' });
            return;
          }
          if (serverError && attempt < MAX_CANDIDATE_RETRIES) {
            upRes.resume(); // drain, do not pipe
            setTimeout(() => resolve({ kind: 'retry' }), RETRY_BACKOFF_MS * (attempt + 1));
            return;
          }
          resolve({ kind: 'response', res: upRes });
        });
        up.on('error', (e) => {
          log('upstream error (' + prefix + ' cand ' + candidateIndex + ' attempt ' + (attempt + 1) + '): ' + e.message);
          route._candidateCooldown.fail(candidateIndex);
          resolve(attempt < MAX_CANDIDATE_RETRIES ? { kind: 'retry' } : { kind: 'failover' });
        });
        if (newBody && newBody.length) up.write(newBody);
        up.end();
      });
    }
    async function tryCand(position) {
      if (position >= candidateOrder.length) {
        if (!clientRes.headersSent) {
          clientRes.writeHead(502, { 'content-type': 'application/json' });
          clientRes.end(
            JSON.stringify({
              error: { type: 'all_candidates_failed', message: 'all auth candidates for ' + prefix + ' failed' },
            })
          );
        }
        return;
      }
      const candidateIndex = candidateOrder[position];
      for (let attempt = 0; attempt <= MAX_CANDIDATE_RETRIES; attempt++) {
        const result = await attemptCand(candidateIndex, attempt);
        if (result.kind === 'failover') {
          tryCand(position + 1);
          return;
        }
        if (result.kind === 'retry') {
          if (attempt < MAX_CANDIDATE_RETRIES) {
            log('candidate ' + candidateIndex + ' on ' + prefix + ' transient, retry ' + (attempt + 1) + '/' + MAX_CANDIDATE_RETRIES);
            continue;
          }
          // Exhausted retries on this candidate, fail over.
          log('candidate ' + candidateIndex + ' on ' + prefix + ' exhausted retries -> failing over');
          tryCand(position + 1);
          return;
        }
        // Final upstream response: return it as-is.
        const upRes = result.res;
        if (!clientRes.headersSent) clientRes.writeHead(upRes.statusCode, upRes.headers);
        upRes.pipe(clientRes);
        return;
      }
    }
    tryCand(0);
  });
  clientReq.on('error', () => {
    if (!clientRes.headersSent) clientRes.writeHead(400).end('client error');
  });
}

const server = http.createServer((req, res) => {
  if (req.method === 'GET' && req.url.split('?')[0] === '/v1/models') {
    handleModels(res);
    return;
  }
  if (req.method === 'POST' && req.url.split('?')[0] === '/v1/messages') {
    if (requestToken(req.headers) !== GATEWAY_TOKEN) {
      req.resume();
      rejectUnauthorized(res);
      return;
    }
    handleMessage(req, res);
    return;
  }
  res.writeHead(404, { 'content-type': 'application/json' });
  res.end(JSON.stringify({ error: { type: 'not_found', message: 'only /v1/messages and /v1/models are served' } }));
});

server.listen(PORT, '127.0.0.1', () => {
  const actual = server.address().port;
  process.stdout.write('CROUTER_GATEWAY_LISTENING_PORT=' + actual + '\n');
  log(
    'listening on 127.0.0.1:' + actual + ' | providers=' + ROUTES.map((r) => r.prefix).join(',') +
      ' | models=' + ROUTES.reduce((a, r) => a + r.models.length, 0)
  );
});

function shutdown() {
  server.close(() => process.exit(0));
  setTimeout(() => process.exit(0), 500).unref();
}
process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);
